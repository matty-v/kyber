{
  "name": "kyber-embedded-pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The kyber control-plane's embedded PWA. Imports @matty-v/kyber-pwa-views and provides EmbeddedClusterProvider.",
  "scripts": {
    "dev": "vite",
    "dev:mocks": "VITE_ENABLE_MOCKS=1 vite",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "screenshots": "playwright test --config=playwright.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@matty-v/kyber-pwa-views": "*",
    "@tanstack/react-query": "^5.101.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
