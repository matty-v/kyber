#!/usr/bin/env bash
set -euo pipefail

runtime="${1:-}"
payload="$(cat)"
prompt="$(jq -r '.prompt // empty' <<<"$payload")"
header="${prompt%%$'\n'*}"
if [[ ! "$header" =~ ^\[kyber-task:(task_[a-f0-9]{32})\]\ attempt=(attempt_[a-f0-9]{32})$ ]]; then
    exit 0
fi

task_id="${BASH_REMATCH[1]}"
attempt_id="${BASH_REMATCH[2]}"
session_id="$(jq -r '.session_id // empty' <<<"$payload")"
turn_id="$(jq -r '.turn_id // empty' <<<"$payload")"
event="$(jq -r '.hook_event_name // empty' <<<"$payload")"
[[ "$runtime" =~ ^(claude-code|codex)$ ]] || exit 2
[[ "$session_id" =~ ^[A-Za-z0-9._:-]{1,256}$ ]] || exit 2
[[ -z "$turn_id" || "$turn_id" =~ ^[A-Za-z0-9._:-]{1,256}$ ]] || exit 2
[[ "$event" == "UserPromptSubmit" ]] || exit 2

receipt="$(jq -nc --arg task "$task_id" --arg attempt "$attempt_id" --arg runtime "$runtime" --arg session "$session_id" --arg turn "$turn_id" '{taskId:$task,attemptId:$attempt,runtime:$runtime,sessionId:$session} + if $turn == "" then {} else {turnId:$turn} end')"
receipt_dir="${KYBER_TASK_RECEIPT_DIR:-/persist/var/lib/kyber-task-receipts}"
install -d -m 0700 "$receipt_dir"
receipt_file="$receipt_dir/${attempt_id}.json"
if [[ -f "$receipt_file" ]] && ! cmp -s "$receipt_file" <(printf '%s\n' "$receipt"); then
    exit 2
fi
tmp="$(mktemp "$receipt_dir/.${attempt_id}.XXXXXX")"
printf '%s\n' "$receipt" >"$tmp"
chmod 0600 "$tmp"
mv -f -- "$tmp" "$receipt_file"

base="${KYBER_TASK_RECEIPT_URL:-http://127.0.0.1:8091/task-receipts}"
response="$(mktemp "$receipt_dir/.response.XXXXXX")"
trap 'rm -f -- "$response"' EXIT
status="$(curl -sS --max-time 10 -o "$response" -w '%{http_code}' -H 'Content-Type: application/json' --data-binary @"$receipt_file" "$base" || true)"
if [[ "$status" == 200 || "$status" == 201 ]]; then
    jq -e --argjson want "$receipt" '(.receipt // .) == $want' "$response" >/dev/null && exit 0
fi
status="$(curl -sS --max-time 10 -o "$response" -w '%{http_code}' "$base/$attempt_id" || true)"
[[ "$status" == 200 ]] && jq -e --argjson want "$receipt" '. == $want' "$response" >/dev/null && exit 0
exit 2
