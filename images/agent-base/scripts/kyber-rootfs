#!/bin/bash
#
# kyber-rootfs — prepare the agent's durable root filesystem.
#
# Kyber agents own their root filesystem: they install packages, edit /etc,
# and expect all of it to survive pod replacement. Historically that was an
# overlayfs mount performed inside the pod, which required a host-valid
# CAP_SYS_ADMIN and made the agent a host-escape risk (kyber#76).
#
# Under a user namespace neither kernel overlayfs nor FUSE is available at all
# (see docs/adr/0003-agent-sandbox-isolation.md for the measurements), so the
# overlay is gone. The agent's root is now an ordinary directory tree on its
# PersistentVolume, seeded from the base image on first boot and entered with
# chroot. Every mount the entrypoint still performs — bind, proc, tmpfs — is
# permitted to a *namespaced* CAP_SYS_ADMIN, which carries no host authority.
#
# The interesting problem this creates is upgrades. With an overlay, a new base
# image arrived for free as a new lower layer. With a real root, delivering a
# new base image to a root the agent has been editing for months is a
# three-way merge, and that is most of what this script does.
#
# Usage:
#   kyber-rootfs prepare <rootfs-dir>     seed, migrate, or upgrade in place
#   kyber-rootfs manifest <root> <out>    write a manifest of <root>
#
# `prepare` prints the resulting mode on stdout. Every other message goes to
# stderr so the caller can capture the mode cleanly.
#
# Exit status is non-zero on any failure that would leave the agent running on
# the wrong filesystem. Callers must treat that as fatal — silently continuing
# on an ephemeral root is how an agent loses a month of state.

set -euo pipefail

# The base image's own root. Overridable so the merge logic can be exercised
# against synthetic trees in tests — the merge is the riskiest code here and
# "it looked right" is not evidence.
IMAGE_ROOT="${IMAGE_ROOT:-/}"
PERSIST_DIR="${PERSIST_DIR:-/persist}"
STATE_DIR="$PERSIST_DIR/kyber"
MANIFEST="$STATE_DIR/rootfs-image-manifest.tsv"
CONFLICT_LOG="$STATE_DIR/rootfs-upgrade-conflicts.log"
LEGACY_UPPER="${LEGACY_UPPER:-$PERSIST_DIR/overlay/upper}"

# Never part of the durable root: kernel filesystems, the volume itself, and
# the directories the entrypoint bind-mounts over once the chroot is
# assembled. Seeded as empty directories so the bind targets exist.
EXCLUDE_DIRS=(
    ./proc ./sys ./dev ./persist ./merged ./run ./tmp
    ./secrets ./user-secrets ./kyber/jobs-src
)

# Seeded normally, but never allowed to drive an upgrade: these are rewritten
# on every pod, so they differ from the recorded image on every boot and would
# otherwise make every boot look like a base-image change.
MANIFEST_EXCLUDE_FILES=(
    ./etc/resolv.conf ./etc/hosts ./etc/hostname ./etc/mtab
)

# The subset of those the entrypoint bind-mounts over, which therefore have to
# exist as regular files for the mount to have somewhere to land.
#
# NOT the same list as above, and deliberately so: /etc/mtab is volatile but is
# a SYMLINK to /proc/self/mounts in the base image. Creating it unconditionally
# followed that symlink into a /proc that is not populated yet and failed the
# whole boot — which the fail-closed guard then correctly turned into a refusal
# to start rather than an agent quietly running on an ephemeral root.
BIND_TARGET_FILES=(
    ./etc/resolv.conf ./etc/hosts ./etc/hostname
)

log() { echo "[kyber-rootfs] $*" >&2; }
die() { echo "[kyber-rootfs] FATAL: $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# manifest — one line per path: <type>\t<size>\t<mtime>\t<mode>\t<path>
#
# Used to answer the only question that matters during an upgrade: has the
# agent touched this file since we last wrote it? For files, type+size+mtime+
# mode is enough — tar and cp -a both preserve mtime, so an untouched file
# compares equal cheaply and anything the agent wrote gets a fresh one.
#
# DIRECTORIES record no size or mtime, and that is deliberate. A directory's
# mtime changes whenever anything is created inside it, so the container root
# `.` alone differed between two otherwise identical pods (the entrypoint
# creates /merged before this runs). That one line made every boot look like a
# base-image change and ran a full three-way merge on every single start.
# Directory mtimes carry no information about whether the IMAGE changed, so
# they are normalised away.
# ---------------------------------------------------------------------------
manifest_printf='%y\t%s\t%T@\t%m\t%p\n'
manifest_dir_printf='%y\t-\t-\t%m\t%p\n'

# Bump when the manifest format changes. A recorded manifest in an older format
# cannot be compared entry-for-entry with a new one — the first attempt at this
# logged a conflict for all 3980 directories in the image on the boot after the
# format changed. A version mismatch means "adopt this root as-is and record the
# current image", never "merge against something you cannot read".
MANIFEST_VERSION=2

write_manifest() {
    local root="$1" out="$2"
    local -a args=(.)
    local e
    for e in "${EXCLUDE_DIRS[@]}" "${MANIFEST_EXCLUDE_FILES[@]}"; do
        args+=(-path "$e" -prune -o)
    done
    args+=(-type d -printf "$manifest_dir_printf" -o -printf "$manifest_printf")
    (
        cd "$root" || exit 1
        find "${args[@]}" 2>/dev/null
    ) | LC_ALL=C sort -t$'\t' -k5 > "$out.body"
    {
        echo "#kyber-rootfs-manifest v$MANIFEST_VERSION"
        cat "$out.body"
    } > "$out.tmp"
    rm -f "$out.body"
    mv "$out.tmp" "$out"
}

# Reads the version header off a recorded manifest. A manifest with no header
# predates versioning and is treated as unreadable.
manifest_version() {
    local f="$1" line
    [ -f "$f" ] || { echo 0; return; }
    line=$(head -1 "$f")
    case "$line" in
        "#kyber-rootfs-manifest v"*) echo "${line##*v}" ;;
        *) echo 0 ;;
    esac
}

# ---------------------------------------------------------------------------
# seed — first boot. Copy the image root onto the volume.
# ---------------------------------------------------------------------------
seed_rootfs() {
    local root="$1"
    log "first boot — seeding durable root from image"
    mkdir -p "$root"
    local -a tar_excludes=()
    local e
    for e in "${EXCLUDE_DIRS[@]}"; do
        tar_excludes+=("--exclude=$e")
    done
    # numeric-owner keeps uid/gid stable regardless of how the target volume
    # reports ownership; --xattrs carries file capabilities on binaries such
    # as ping. Failure here is fatal: a half-seeded root is worse than none.
    tar -C "$IMAGE_ROOT" "${tar_excludes[@]}" --numeric-owner --xattrs -cf - . \
        | tar -C "$root" --numeric-owner --xattrs -xf - \
        || die "seeding the durable root failed"
    ensure_mount_targets "$root"
    log "durable root seeded ($(du -sh "$root" 2>/dev/null | cut -f1))"
}

ensure_mount_targets() {
    local root="$1" e
    for e in "${EXCLUDE_DIRS[@]}"; do
        mkdir -p "$root/${e#./}"
    done
    chmod 1777 "$root/tmp" 2>/dev/null || true
    # Bind targets for the kubelet-injected files. Must exist or the
    # entrypoint's bind mounts have nowhere to land. The -L test matters: a
    # dangling symlink is "present" for our purposes, and following it would
    # write somewhere we did not intend.
    for e in "${BIND_TARGET_FILES[@]}"; do
        local target="$root/${e#./}"
        [ -e "$target" ] || [ -L "$target" ] || : > "$target"
    done
}

# ---------------------------------------------------------------------------
# migrate — an agent arriving from the overlay era. /persist/overlay/upper
# holds everything it ever changed; compose that over a fresh image seed.
#
# The upper layer is left untouched so rollback to the overlay entrypoint is
# a flag flip, not a restore.
# ---------------------------------------------------------------------------
migrate_from_overlay() {
    local root="$1"
    log "migrating overlay upper layer into the durable root"
    seed_rootfs "$root"

    # Overlay whiteouts are 0/0 character devices meaning "deleted in the
    # upper layer". Apply them as deletions before copying the rest over.
    local whiteouts=0 wh rel
    while IFS= read -r -d '' wh; do
        rel="${wh#"$LEGACY_UPPER"/}"
        rm -rf "${root:?}/$rel"
        whiteouts=$((whiteouts + 1))
    done < <(find "$LEGACY_UPPER" -type c -size 0 -print0 2>/dev/null)

    # Opaque directories (trusted.overlay.opaque=y) replace the lower
    # directory entirely — clear the seeded copy first.
    local dir opaque=0
    while IFS= read -r -d '' dir; do
        if getfattr -n trusted.overlay.opaque --only-values "$dir" 2>/dev/null \
            | grep -q '^y$'; then
            rel="${dir#"$LEGACY_UPPER"/}"
            rm -rf "${root:?}/$rel"
            mkdir -p "${root:?}/$rel"
            opaque=$((opaque + 1))
        fi
    done < <(find "$LEGACY_UPPER" -type d -print0 2>/dev/null)

    tar -C "$LEGACY_UPPER" --numeric-owner --xattrs -cf - . 2>/dev/null \
        | tar -C "$root" --numeric-owner --xattrs -xf - \
        || die "copying the overlay upper layer failed"

    # Whiteout device nodes ride along in the tar; strip them from the result.
    find "$root" -type c -size 0 -delete 2>/dev/null || true
    ensure_mount_targets "$root"
    log "migration complete ($whiteouts whiteouts, $opaque opaque dirs applied)"
}

# ---------------------------------------------------------------------------
# upgrade — a new base image against a root the agent has been living in.
#
# Three-way merge against the manifest written at the last seed/upgrade:
#
#   image changed + agent untouched  -> take the image's version
#   image changed + agent modified   -> keep the agent's, record a conflict
#   image added                      -> add it, unless the agent already has it
#   image removed + agent untouched  -> remove it
#   image removed + agent modified   -> keep the agent's
#
# The rule is the one an operator would expect: Kyber may update anything the
# agent has not claimed, and never silently overwrites the agent's work.
# ---------------------------------------------------------------------------
upgrade_rootfs() {
    local root="$1" old_manifest="$2" new_manifest="$3"
    local updated=0 added=0 removed=0 conflicts=0 failed=0
    local type size mtime mode path new old have
    local -a failed_paths=()

    # A path whose install failed must NOT have its manifest entry advanced, or
    # it compares equal forever and is never retried.
    record_failure() {
        echo "FAILED to install from image (will retry next boot): $1" >> "$CONFLICT_LOG"
        failed_paths+=("$1")
        failed=$((failed + 1))
    }

    mkdir -p "$STATE_DIR"
    : > "$CONFLICT_LOG"

    declare -A old_entry=() new_entry=()
    while IFS=$'\t' read -r type size mtime mode path; do
        [ -n "$path" ] || continue          # skips the version header
        old_entry["$path"]="$type	$size	$mtime	$mode"
    done < "$old_manifest"
    while IFS=$'\t' read -r type size mtime mode path; do
        [ -n "$path" ] || continue
        new_entry["$path"]="$type	$size	$mtime	$mode"
    done < "$new_manifest"

    # Does the agent's copy still match what Kyber last installed there?
    # Same normalisation as write_manifest: directories compare on type+mode
    # only, so an unrelated write inside a directory never reads as "the agent
    # modified this directory".
    agent_untouched() {
        local p="$1" want="${old_entry[$1]:-}" h
        [ -n "$want" ] || return 1
        if [ -d "$root/$p" ] && [ ! -L "$root/$p" ]; then
            h=$(cd "$root" && find "$p" -maxdepth 0 -printf '%y\t-\t-\t%m' 2>/dev/null) || return 1
        else
            h=$(cd "$root" && find "$p" -maxdepth 0 -printf '%y\t%s\t%T@\t%m' 2>/dev/null) || return 1
        fi
        [ "$h" = "$want" ]
    }

    # cp --parents resolves its source relative to the current directory, and
    # every manifest path is relative to the image root.
    cd "$IMAGE_ROOT"

    # Install one path from the image. Directories are updated in place — never
    # deleted and re-copied — because `cp -a --parents` on a directory copies it
    # RECURSIVELY, so "the image changed this directory's mode" would otherwise
    # overwrite everything the agent had put inside it.
    #
    # Returns non-zero on failure, and the caller must treat that as loud. It
    # used to be silent: `cp … 2>/dev/null` failed, the `&&` skipped the
    # counter, nothing reached the conflict log, and the manifest advanced
    # anyway — so the path compared equal on every later boot and was never
    # retried. A type change (image turns a directory into a file) and ENOSPC
    # on a full PVC both land there.
    install_from_image() {
        local p="$1"
        if [ -d "$IMAGE_ROOT/$p" ] && [ ! -L "$IMAGE_ROOT/$p" ]; then
            # Image wants a directory. If the agent's copy is a non-directory,
            # replace it; a stale file where a directory belongs breaks
            # everything underneath it.
            if [ -e "$root/$p" ] && [ ! -d "$root/$p" ]; then
                rm -f "${root:?}/$p" || return 1
            fi
            mkdir -p "$root/$p" || return 1
            chmod --reference="$IMAGE_ROOT/$p" "$root/$p" 2>/dev/null || true
            chown --reference="$IMAGE_ROOT/$p" "$root/$p" 2>/dev/null || true
            return 0
        fi
        # Image wants a non-directory. If the agent's copy is a directory, only
        # remove it when it is EMPTY — rm -rf here would take agent files with
        # it, which is the bug the deepest-first removal ordering exists to
        # avoid. A non-empty directory is reported as a conflict instead.
        if [ -d "$root/$p" ] && [ ! -L "$root/$p" ]; then
            rmdir "${root:?}/$p" 2>/dev/null || return 1
        else
            rm -f "${root:?}/$p" 2>/dev/null || true
        fi
        cp -a --parents "$p" "$root/" 2>/dev/null
    }

    for path in "${!new_entry[@]}"; do
        new="${new_entry[$path]}"
        old="${old_entry[$path]:-}"
        if [ -z "$old" ]; then
            # New in this image. Only add if the agent has not made its own.
            if [ ! -e "$root/$path" ] && [ ! -L "$root/$path" ]; then
                if install_from_image "$path"; then
                    added=$((added + 1))
                else
                    record_failure "$path"
                fi
            fi
            continue
        fi
        [ "$new" = "$old" ] && continue   # image did not change this path
        if agent_untouched "$path"; then
            if install_from_image "$path"; then
                updated=$((updated + 1))
            else
                record_failure "$path"
            fi
        else
            echo "kept agent copy: $path" >> "$CONFLICT_LOG"
            conflicts=$((conflicts + 1))
        fi
    done

    # Removals run DEEPEST-FIRST, and a directory is removed with rmdir rather
    # than rm -rf.
    #
    # Bash iterates an associative array in no particular order, so a parent
    # directory could otherwise be reached before its children — and `rm -rf` on
    # it would take an agent-modified file inside it with no conflict logged and
    # nothing to show it happened. Sorting deepest-first means every child is
    # judged on its own first, and rmdir then refuses to remove a directory that
    # still holds anything the agent kept.
    local removal
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        if agent_untouched "$path"; then
            if [ -d "$root/$path" ] && [ ! -L "$root/$path" ]; then
                rmdir "${root:?}/$path" 2>/dev/null && removed=$((removed + 1))
            else
                rm -f "${root:?}/$path" 2>/dev/null && removed=$((removed + 1))
            fi
        else
            echo "kept agent copy of removed path: $path" >> "$CONFLICT_LOG"
            conflicts=$((conflicts + 1))
        fi
    done < <(
        for removal in "${!old_entry[@]}"; do
            [ -n "${new_entry[$removal]:-}" ] && continue   # still shipped
            printf '%s\t%s\n' "$(awk -F/ '{print NF}' <<<"$removal")" "$removal"
        done | sort -rn -k1,1 | cut -f2-
    )

    # Roll back the manifest entry for every path that failed to install, so the
    # next boot sees a difference again and retries instead of concluding the
    # image never changed it.
    if [ "${#failed_paths[@]}" -gt 0 ]; then
        local tmp="$new_manifest.fixup" fp
        cp "$new_manifest" "$tmp"
        for fp in "${failed_paths[@]}"; do
            grep -v -F -x -- "${new_entry[$fp]}	$fp" "$tmp" > "$tmp.next" || true
            if [ -n "${old_entry[$fp]:-}" ]; then
                printf '%s\t%s\n' "${old_entry[$fp]}" "$fp" >> "$tmp.next"
            fi
            mv "$tmp.next" "$tmp"
        done
        mv "$tmp" "$new_manifest"
    fi

    log "base-image upgrade merged: $updated updated, $added added, $removed removed, $conflicts kept by agent, $failed failed"
    if [ "$failed" -gt 0 ]; then
        log "WARNING: $failed path(s) could not be installed from the image and will be retried next boot — see $CONFLICT_LOG"
    fi
    [ "$conflicts" -gt 0 ] || [ "$failed" -gt 0 ] && log "detail: $CONFLICT_LOG"
    return 0
}

# ---------------------------------------------------------------------------

cmd_prepare() {
    local root="${1:?usage: kyber-rootfs prepare <rootfs-dir>}"
    local mode new_manifest="$STATE_DIR/rootfs-image-manifest.new"

    mkdir -p "$STATE_DIR"
    write_manifest "$IMAGE_ROOT" "$new_manifest"

    if [ ! -d "$root/usr" ]; then
        if [ -d "$LEGACY_UPPER" ] && [ -n "$(ls -A "$LEGACY_UPPER" 2>/dev/null)" ]; then
            migrate_from_overlay "$root"
            mode="rootfs-migrated"
        else
            seed_rootfs "$root"
            mode="rootfs-seeded"
        fi
    elif [ "$(manifest_version "$MANIFEST")" != "$MANIFEST_VERSION" ]; then
        # Either no manifest at all (a root that predates tracking) or one
        # written in a format this version cannot compare against. Adopt the
        # root as-is and record the running image, so the NEXT upgrade has a
        # baseline it can actually read. Merging here would mark every entry as
        # agent-modified and deliver no base-image updates at all.
        log "no comparable manifest — adopting the durable root, no merge this boot"
        ensure_mount_targets "$root"
        mode="rootfs-adopted"
    elif cmp -s "$MANIFEST" "$new_manifest"; then
        ensure_mount_targets "$root"
        mode="rootfs"
    else
        log "base image changed since last boot — merging"
        upgrade_rootfs "$root" "$MANIFEST" "$new_manifest"
        ensure_mount_targets "$root"
        mode="rootfs-upgraded"
    fi

    mv "$new_manifest" "$MANIFEST"
    echo "$mode"
}

case "${1:-}" in
    prepare)  shift; cmd_prepare "$@" ;;
    manifest) shift; write_manifest "${1:?root}" "${2:?out}" ;;
    *)        die "usage: kyber-rootfs {prepare <dir>|manifest <root> <out>}" ;;
esac
