#!/usr/bin/env bash
set -euo pipefail

usage() { echo "usage: kyber-harness-install <package> <version> <binary>" >&2; exit 2; }
[ "$#" -eq 3 ] || usage
package="$1" version="$2" binary="$3"
if ! [[ "$package" =~ ^@[0-9A-Za-z._-]+/[0-9A-Za-z._-]+$ ]] ||
   ! [[ "$version" =~ ^[0-9A-Za-z.-]+$ ]] ||
   ! [[ "$binary" =~ ^[0-9A-Za-z._-]+$ ]] || [ "${#version}" -gt 64 ]; then
    echo "[kyber] harness install: invalid package, version, or binary" >&2; exit 2
fi

npm_bin="${KYBER_HARNESS_NPM:-$(command -v npm || true)}"
[ -n "$npm_bin" ] || { echo "[kyber] harness install: npm not found" >&2; exit 1; }
global_root="${KYBER_HARNESS_GLOBAL_ROOT:-$("$npm_bin" root -g)}"
global_prefix="${KYBER_HARNESS_GLOBAL_PREFIX:-$("$npm_bin" prefix -g)}"
live="$global_root/$package"
parent="$(dirname "$live")" base="$(basename "$live")"
backup="$parent/.${base}.kyber-backup" lock="$parent/.${base}.kyber-install.lock"
stage="" candidate="" link_tmp="" swapping=false

mkdir -p "$parent" "$global_prefix/bin"
exec 9>"$lock"
flock -n 9 || { echo "[kyber] harness install: another $package install is already active" >&2; exit 1; }

version_of() {
    local output
    output="$("$1" --version 2>/dev/null)" || return 1
    printf '%s\n' "$output" | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+([0-9A-Za-z.+-]*)?' | head -1
}

# Read npm's declared bin entry from a package already on disk. This lets us
# recover a killed activation before touching npm or the registry.
binary_rel_of() {
    node - "$1/package.json" "$binary" <<'NODE'
const fs = require('fs');
const path = require('path');
const manifest = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
let entry = manifest.bin;
if (typeof entry === 'string') entry = { [process.argv[3]]: entry };
entry = entry && entry[process.argv[3]];
if (typeof entry !== 'string' || path.isAbsolute(entry)) process.exit(1);
const normalized = path.normalize(entry);
if (normalized === '..' || normalized.startsWith('../')) process.exit(1);
process.stdout.write(normalized);
NODE
}

valid_dir_version() {
    local dir="$1" rel
    rel="$(binary_rel_of "$dir" 2>/dev/null)" || return 1
    [ -x "$dir/$rel" ] || return 1
    version_of "$dir/$rel"
}

repair_link() {
    local rel="$1" target
    target="$(realpath --relative-to="$global_prefix/bin" "$live/$rel")"
    link_tmp="$global_prefix/bin/.${binary}.kyber-new.$$"
    rm -f -- "$link_tmp"
    ln -s "$target" "$link_tmp"
    mv -Tf "$link_tmp" "$global_prefix/bin/$binary"
    link_tmp=""
}

cleanup() {
    rc=$?
    trap - EXIT INT TERM HUP
    [ -z "$link_tmp" ] || rm -f -- "$link_tmp"
    if [ "$swapping" = true ]; then
        rm -rf -- "$live"
        if [ -e "$backup" ]; then
            mv "$backup" "$live" || true
            rollback_rel="$(binary_rel_of "$live" 2>/dev/null || true)"
            [ -z "$rollback_rel" ] || repair_link "$rollback_rel" || true
        fi
    fi
    [ -z "$candidate" ] || rm -rf -- "$candidate"
    [ -z "$stage" ] || rm -rf -- "$stage"
    exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

# Resolve every filesystem state SIGKILL can leave before network access.
if [ -e "$backup" ] && [ ! -e "$live" ]; then
    echo "[kyber] harness install: restoring interrupted $package swap"
    mv "$backup" "$live"
elif [ -e "$backup" ] && [ -e "$live" ]; then
    if valid_dir_version "$live" >/dev/null; then
        rm -rf -- "$backup"
    elif valid_dir_version "$backup" >/dev/null; then
        echo "[kyber] harness install: rolling back incomplete $package activation"
        rm -rf -- "$live"; mv "$backup" "$live"
    else
        echo "[kyber] harness install: live and backup $package installs are both invalid; refusing destructive recovery" >&2
        exit 1
    fi
fi

for stale in "$parent/.${base}.kyber-new."* "$parent/.${base}-"*; do
    [ -e "$stale" ] || continue
    rm -rf -- "$stale"
done
for stale in "$global_prefix/bin/.${binary}.kyber-new."*; do
    [ -e "$stale" ] || [ -L "$stale" ] || continue
    rm -f -- "$stale"
done

# Heal the command link immediately. A restored requested version needs no npm.
live_version="$(valid_dir_version "$live" 2>/dev/null || true)"
if [ -n "$live_version" ]; then
    binary_rel="$(binary_rel_of "$live")"
    repair_link "$binary_rel"
    if [ "$live_version" = "$version" ]; then
        echo "[kyber] harness install: ${package}@${version} already active"
        exit 0
    fi
fi

stage="$(mktemp -d "${TMPDIR:-/tmp}/kyber-harness-stage.XXXXXXXX")"
echo "[kyber] harness install: staging ${package}@${version}"
"$npm_bin" install --global --prefix "$stage" --no-audit --no-fund "${package}@${version}"
staged_package="$stage/lib/node_modules/$package" staged_binary="$stage/bin/$binary"
[ -d "$staged_package" ] || { echo "[kyber] harness install: staged package missing" >&2; exit 1; }
[ -x "$staged_binary" ] || { echo "[kyber] harness install: staged binary missing or not executable" >&2; exit 1; }
observed="$(version_of "$staged_binary")" || { echo "[kyber] harness install: staged $binary failed its version check" >&2; exit 1; }
[ "$observed" = "$version" ] || { echo "[kyber] harness install: staged $binary reports $observed, expected $version" >&2; exit 1; }
binary_rel="$(binary_rel_of "$staged_package")" || { echo "[kyber] harness install: staged package has no safe $binary bin entry" >&2; exit 1; }
resolved_binary="$(readlink -f "$staged_binary")"
[ "$resolved_binary" = "$(readlink -f "$staged_package/$binary_rel")" ] || { echo "[kyber] harness install: staged binary does not match package manifest" >&2; exit 1; }

candidate="$parent/.${base}.kyber-new.$$"
rm -rf -- "$candidate"
cp -a "$staged_package" "$candidate"
candidate_version="$(version_of "$candidate/$binary_rel")" || { echo "[kyber] harness install: copied $binary failed its version check" >&2; exit 1; }
[ "$candidate_version" = "$version" ] || { echo "[kyber] harness install: copied $binary reports $candidate_version, expected $version" >&2; exit 1; }

swapping=true
[ ! -e "$live" ] || mv "$live" "$backup"
mv "$candidate" "$live"; candidate=""
[ "${KYBER_HARNESS_TEST_SIGNAL_AFTER_SWAP:-}" != "1" ] || kill -TERM "$$"
live_version="$(version_of "$live/$binary_rel")" || { echo "[kyber] harness install: live $binary failed after swap; rolling back" >&2; exit 1; }
[ "$live_version" = "$version" ] || { echo "[kyber] harness install: live $binary reports $live_version after swap; rolling back" >&2; exit 1; }
repair_link "$binary_rel"
rm -rf -- "$backup"
swapping=false
echo "[kyber] harness install: activated ${package}@${version}"
